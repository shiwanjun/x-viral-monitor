  "contentUpdateItemReplyToolsBody": {
    "message": "Added an option to send comments with Enter. Enable it in Settings → Other features → Press Enter to reply, then you no longer need Command + Enter in reply boxes."
  },
  "contentUpdateItemHotOnlyTitle": {
    "message": "Hot only state is clearer"
  },
  "contentUpdateItemHotOnlyBody": {
    "message": "When Hot only is enabled, posts below the threshold are removed from the page. You can choose where it applies in the Popup or floating panel settings."
  },
  "contentUpdateItemBookmarkToolsTitle": {
    "message": "Bookmark tools are easier to find"
  },
  "contentUpdateItemBookmarkToolsBody": {
    "message": "In Settings → Other features, enable the bookmark folder menu and bookmark counts to pick save folders, see saved locations, and show bookmark counts on the timeline."
  },
  "contentUpdateItemFilterRulesTitle": {
    "message": "Content filtering is steadier"
  },
