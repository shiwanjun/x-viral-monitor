# ─────────────────────────────────────────────────────────────────────
# X-Tools environment configuration — copy to .env.test or .env.production
# and fill in real values. NEVER commit real .env files.
# ─────────────────────────────────────────────────────────────────────

# ─── Better Auth ─────────────────────────────────────────────────────
# Base URL where this Worker is reachable. Better Auth uses it to build
# the Google OAuth callback URL: ${BETTER_AUTH_URL}/api/auth/callback/google
# Test and production both use the same domain.
BETTER_AUTH_URL=https://x.jieyiai.dev
# Generate with: openssl rand -base64 32  (min 32 chars)
BETTER_AUTH_SECRET=replace_with_generated_secret
# Optional: used only by Better Auth Infrastructure plugins, not Google OAuth.
BETTER_AUTH_API_KEY=

# ─── Google OAuth (Google Cloud Console → APIs & Services → Credentials) ──
# Create an OAuth 2.0 Client ID (type: Web application).
# Add these Authorized redirect URIs:
#   https://x.jieyiai.dev/api/auth/callback/google
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# ─── Waffo Pancake ───────────────────────────────────────────────────
# Merchant ID and Store ID from Waffo Dashboard.
WAFFO_MERCHANT_ID=replace_with_MER_xxx
WAFFO_STORE_ID=replace_with_MER_xxx
# RSA PKCS#8 private key in PEM format. Download from Waffo Dashboard →
# API & Development → API Keys. NEVER commit this.
WAFFO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_FULL_PEM_KEY\n-----END PRIVATE KEY-----"
# Waffo platform-level webhook public key. Copy from Waffo Dashboard →
# Settings → Webhooks → Webhook Public Key (for the matching environment).
WAFFO_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_FULL_PEM_PUBLIC_KEY\n-----END PUBLIC KEY-----"
# "test" or "prod" — must match the API key environment.
WAFFO_ENV=test

# ─── Waffo subscription product IDs ──────────────────────────────────
# Create these in Waffo Dashboard (subscription products, monthly), then
# paste the PROD_xxx IDs here.
WAFFO_PRODUCT_STANDARD=PROD_xxx_standard_399
WAFFO_PRODUCT_PRO=PROD_xxx_pro_599
WAFFO_PRODUCT_MAX=PROD_xxx_max_799

# ─── CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed extension origins.
ALLOWED_ORIGIN=chrome-extension://dkplofpecmjmbhgjgleeflcnfgfkdfpd
